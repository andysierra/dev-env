// Sublime Text — Linux Mint (variante de ../../sublime/settings.txt)
{
	"folder_exclude_patterns": [                                         
        "build",                                         
        ".git",                                                         
        "node_modules"                                                          
    ],                                               
    "index_exclude_patterns": [                                                               
        "build/*"                                          
    ],
	// Package Control NO se ignora (en ../../sublime/settings.txt sí): en un PC nuevo es quien
	// instala gruvbox y Terminus (lista en Package Control.sublime-settings).
	"ignored_packages":
	[
		"Vintage",
	],
	"font_size": 12,
	"open_files_in_new_window": false,
	"remember_open_files": false,
	"hot_exit": false,
	"theme": "Adaptive.sublime-theme",
	"gruvbox_tabs_xxs": true,
	"gruvbox_statusbar_xxs": true,
	"color_scheme": "Packages/gruvbox/gruvbox (Dark) (Hard).sublime-color-scheme",
	"index_files": false,
}
