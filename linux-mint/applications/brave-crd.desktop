[Desktop Entry]
Name=crd (Brave · dev)
Comment=Brave con el perfil "Profile 1" (rofi: escribir crd)
Exec=/usr/bin/brave-browser-stable --use-angle=vulkan --enable-features=Vulkan,VulkanFromANGLE,DefaultANGLEVulkan,AcceleratedVideoDecodeLinuxGL,VaapiVideoDecoder --profile-directory="Profile 1" %U
Icon=brave-browser
Type=Application
Terminal=false
Categories=Network;WebBrowser;
StartupWMClass=brave-browser
StartupNotify=true
